# The web host runs PHP as CGI and refuses scripts (403) without this.
Options +ExecCGI

# api.php answers at api/<endpoint>. Scripts are not reachable by name.
RewriteEngine On
RewriteCond %{THE_REQUEST} ^\S+\s[^?\s]*\.php[?\s/]
RewriteRule ^ - [R=404,L]
RewriteRule ^api/[^/]+$ api.php [L]
# Dot files, such as the health copy, are not served.
RewriteRule (^|/)\. - [R=404,L]

# api/backend-health ends its answer before it refreshes the health copy.
# Compression would hold the answer back until the script ends.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "/api/[^/]+$" no-gzip=1
</IfModule>

# Browsers revalidate the page on every load (a cheap 304 when unchanged).
# Stylesheet, script and icons are cached for an hour: the page names them
# with the release as a version stamp, so a new release is a new URL.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|png)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
