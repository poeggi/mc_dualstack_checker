# TLS termination for the backend. Caddy obtains and renews the certificate.
# The API is public; the landing page and icon are served from /var/www/mcdc.
# Forwarded client addresses are trusted from the web host only, so direct
# callers cannot spoof the address the limits are charged to.
mcdscheck-api.poggensee.it {
	root * /var/www/mcdc
	header -Server
	header -Via
	# HTTPS only, no content sniffing, no referrer to other sites.
	header Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"
	# The pages load only this host's own files.
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"
	@api path /ping /health
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			# mcdc-tick sets trusted_proxies to the current addresses of the
			# web host's name below; the addresses given here are the fallback.
			# trusted-host www.poggensee.it
			trusted_proxies 2a01:4f8:d0a:52d1::2/128 88.198.28.140/32
		}
	}
	# The backend's usage files; see backend/stats.go.
	handle /stats/* {
		root * /var/lib/mc-dualstack-check
		header Cache-Control "public, max-age=60"
		file_server
	}
	# Errors of this server itself, such as 404 and 405, get a short text.
	handle_errors {
		header X-Content-Type-Options "nosniff"
		respond "{err.status_code} {err.status_text}"
	}
	handle {
		rewrite /stats /stats.html
		# Pages, scripts and styles change with each release, so browsers
		# revalidate them on every load. Icons are kept for a day.
		@icons path *.svg *.png
		@other not path *.svg *.png
		header @other Cache-Control "no-cache"
		header @icons Cache-Control "public, max-age=86400"
		file_server
	}
}
