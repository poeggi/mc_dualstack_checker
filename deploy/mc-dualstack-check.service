[Unit]
Description=mc_dualstack_check backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=mcdc
Group=mcdc
Environment=PORT=8080
Environment=ALLOWED_ORIGINS=*
Environment=GOMEMLIMIT=64MiB
MemoryMax=128M
ExecStart=/usr/local/bin/mc_dualstack_check
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
