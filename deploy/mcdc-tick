#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Runs every 7 minutes from mcdc-tick.timer, as root. Four jobs:
#   1. Keep Caddy at CADDY_VERSION.
#   2. Install the latest GitHub release whenever its SHA256SUMS changes,
#      so a release published again under the same tag counts as well: the
#      backend binary, and from deploy.tar.gz the Caddy config, the pages
#      (stamped with the release), the systemd units and this script.
#      Outbound only: no deploy key, nothing connects into the VM.
#   3. Keep Caddy's trusted_proxies at the current addresses of the name on
#      the Caddyfile's "# trusted-host" line, resolved by the system.
#   4. Keep the CPU busy for BUSY_SECONDS (default 30 s, about 7 % average
#      load). Some free-tier clouds reclaim VMs whose CPU looks idle for
#      days. BUSY_SECONDS=0 in a drop-in (systemctl edit mcdc-tick) turns
#      this off; releases replace the unit file, not drop-ins.
set -eu

REPO="poeggi/mc_dualstack_checker"
CADDY_VERSION="2.11.4"
BIN="/usr/local/bin/mc_dualstack_check"
CADDY="/usr/local/bin/caddy"
STATE="/var/lib/mcdc"
UNITS="mc-dualstack-check.service mcdc-tick.service mcdc-tick.timer caddy.service"
BUSY_SECONDS=${BUSY_SECONDS:-30}

case "$(uname -m)" in
    x86_64)  ARCH=amd64 ;;
    aarch64) ARCH=arm64 ;;
    *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Every transfer is time-limited, so a stalled download cannot hold the run.
curl() {
    command curl --connect-timeout 5 --max-time 60 "$@"
}

# The functions run in "||" lists, where set -e does not apply, so every
# step that must not fail carries its own "|| return 1".

# put <src> <dst> <mode>: installs src by rename, so a running copy of dst
# (this script, the backend binary) stays intact.
put() {
    install -m "$3" "$1" "$2.new" && mv -f "$2.new" "$2"
}

# stamp_page <page> <version>: writes version into the page's version
# field and into the ?v= stamps of its includes, when they differ.
stamp_page() {
    sed -e "s|\(id=\"api-version\">\)[^<]*|\1$2|" -e "s|?v=[^\"]*\"|?v=$2\"|g" "$1" > "$tmp/page" || return 1
    cmp -s "$tmp/page" "$1" || put "$tmp/page" "$1" 644
}

caddy_update() {
    [ "$("$CADDY" version 2>/dev/null | cut -d' ' -f1)" != "v$CADDY_VERSION" ] || return 0
    name="caddy_${CADDY_VERSION}_linux_$ARCH.tar.gz"
    base="https://github.com/caddyserver/caddy/releases/download/v$CADDY_VERSION"
    mkdir -p "$tmp/caddy" || return 1
    curl -fsSL -o "$tmp/caddy/$name" "$base/$name" || return 1
    curl -fsSL -o "$tmp/caddy/sums" "$base/caddy_${CADDY_VERSION}_checksums.txt" || return 1
    (cd "$tmp/caddy" && grep " $name\$" sums | sha512sum -c --quiet --strict) || return 1
    tar -xzf "$tmp/caddy/$name" -C "$tmp/caddy" caddy || return 1
    put "$tmp/caddy/caddy" "$CADDY" 755 || return 1
    systemctl try-restart caddy
    echo "installed caddy v$CADDY_VERSION"
}

# trusted_render <Caddyfile>: sets its trusted_proxies line to the current
# addresses of the name on its "# trusted-host" line. When the name does
# not resolve, the line stays as it is.
trusted_render() {
    host=$(sed -n 's/^[[:space:]]*# trusted-host \([A-Za-z0-9.-]*\)[[:space:]]*$/\1/p' "$1" | head -n 1)
    [ -n "$host" ] || return 0
    addrs=$(getent ahosts "$host" 2>/dev/null | awk '{print $1}' | sort -u | while read -r a; do
        case "$a" in
            *[!0-9A-Fa-f:.]*) ;;
            *:*) printf '%s/128 ' "$a" ;;
            *)   printf '%s/32 ' "$a" ;;
        esac
    done)
    addrs=${addrs% }
    [ -n "$addrs" ] || { echo "trusted host $host does not resolve, keeping its addresses" >&2; return 0; }
    sed -i "s|^\([[:space:]]*trusted_proxies\) .*|\1 $addrs|" "$1"
}

# trust_update brings the installed Caddy config to the trusted host's
# current addresses and reloads Caddy when they changed.
trust_update() {
    [ -f /etc/caddy/Caddyfile ] || return 0
    cp /etc/caddy/Caddyfile "$tmp/Caddyfile" || return 1
    trusted_render "$tmp/Caddyfile"
    cmp -s "$tmp/Caddyfile" /etc/caddy/Caddyfile && return 0
    "$CADDY" adapt --config "$tmp/Caddyfile" >/dev/null 2>&1 || { echo "trusted addresses give an invalid Caddyfile" >&2; return 1; }
    put "$tmp/Caddyfile" /etc/caddy/Caddyfile 644 || return 1
    systemctl try-reload-or-restart caddy
    echo "trusted proxies: $(sed -n 's/^[[:space:]]*trusted_proxies //p' /etc/caddy/Caddyfile)"
}

# sync_deploy <dir> <version>: installs the deploy files of a release, its
# Caddyfile with the trusted host's current addresses and its pages stamped
# with the version. Caddy reloads when its config changed and restarts when
# its unit did.
sync_deploy() {
    d=$1
    trusted_render "$d/Caddyfile"
    for f in "$d"/www/*.html; do
        stamp_page "$f" "$2" || return 1
    done
    "$CADDY" adapt --config "$d/Caddyfile" >/dev/null 2>&1 || { echo "release Caddyfile invalid" >&2; return 1; }
    units=
    for u in $UNITS; do
        cmp -s "$d/$u" "/etc/systemd/system/$u" && continue
        put "$d/$u" "/etc/systemd/system/$u" 644 || return 1
        units="$units $u"
    done
    caddyfile=
    if ! cmp -s "$d/Caddyfile" /etc/caddy/Caddyfile; then
        put "$d/Caddyfile" /etc/caddy/Caddyfile 644 || return 1
        caddyfile=1
    fi
    for f in "$d"/www/*; do
        put "$f" "/var/www/mcdc/${f##*/}" 644 || return 1
    done
    put "$d/mcdc-tick" /usr/local/bin/mcdc-tick 755 || return 1

    [ -z "$units" ] || systemctl daemon-reload
    case "$units" in
        *caddy.service*) systemctl try-restart caddy ;;
        *) [ -z "$caddyfile" ] || systemctl try-reload-or-restart caddy ;;
    esac
    case "$units" in
        *mcdc-tick.timer*) systemctl restart mcdc-tick.timer ;;
    esac
}

release_update() {
    latest=$(curl -fsS "https://api.github.com/repos/$REPO/releases/latest" \
        | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p')
    [ -n "$latest" ] || { echo "no release found" >&2; return 0; }
    # The tag goes into URLs, a file and a sed expression.
    case "$latest" in *[!A-Za-z0-9._+-]*) echo "unexpected release tag" >&2; return 1 ;; esac
    base="https://github.com/$REPO/releases/download/$latest"
    r="$tmp/release"
    mkdir -p "$r" || return 1
    curl -fsSL -o "$r/SHA256SUMS" "$base/SHA256SUMS" || return 1
    cmp -s "$r/SHA256SUMS" "$STATE/SHA256SUMS" && return 0

    asset="mc_dualstack_check_linux_$ARCH"
    curl -fsSL -o "$r/$asset" "$base/$asset" || return 1
    curl -fsSL -o "$r/deploy.tar.gz" "$base/deploy.tar.gz" || return 1
    (cd "$r" && grep -E " ($asset|deploy\.tar\.gz)\$" SHA256SUMS > want &&
        [ "$(wc -l < want)" -eq 2 ] && sha256sum -c --quiet --strict want) || return 1
    mkdir -p "$r/deploy" && tar -xzf "$r/deploy.tar.gz" -C "$r/deploy" || return 1

    sync_deploy "$r/deploy" "$latest" || return 1
    put "$r/$asset" "$BIN" 755 || return 1
    mkdir -p "$STATE"
    echo "$latest" > "$STATE/version"
    cp "$r/SHA256SUMS" "$STATE/SHA256SUMS"
    systemctl restart mc-dualstack-check
    echo "installed $latest"
}

# The installed pages carry the installed version, also when bootstrap
# copied them unstamped.
stamp() {
    ver=$(cat "$STATE/version" 2>/dev/null) || return 0
    for f in /var/www/mcdc/*.html; do
        [ -f "$f" ] || continue
        stamp_page "$f" "$ver" || return 1
    done
}

caddy_update || echo "caddy update failed, keeping the current one" >&2
release_update || echo "update failed, keeping current version" >&2
trust_update || echo "trusted proxies update failed, keeping the current ones" >&2
stamp || true

[ "$BUSY_SECONDS" -gt 0 ] && { timeout "$BUSY_SECONDS" sh -c 'while :; do :; done' || true; }
exit 0
